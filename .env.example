# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dynamik"

# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Encrypts provider credentials at rest. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Social sign-in
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Reserved ngrok domain, used so webhook triggers reach localhost
NGROK_URL=

# Billing
POLAR_ACCESS_TOKEN=
POLAR_SUCCESS_URL="http://localhost:3000/workflows"

# M-Pesa trigger
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_ENVIRONMENT="sandbox"

# Sentry source map upload at build time
SENTRY_AUTH_TOKEN=
